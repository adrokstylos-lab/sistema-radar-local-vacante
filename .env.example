# Copia este archivo a `.env` y rellena los valores.
# NUNCA subas `.env` a git (ya está en .gitignore).

# --- Base de datos local (Docker Compose) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/radar

# --- Google Places (New) ---
# Usar SOLO para enriquecer, dentro del free tier (caps por SKU).
# Recomendado: restringe la key por API (solo Places) y por IP/referrer en Google Cloud Console.
GOOGLE_PLACES_API_KEY=tu_key_de_google_aqui

# --- Jooble (agregador de empleo) ---
# Key gratuita con LIMITE DE 500 PETICIONES DE POR VIDA. Solicitar en: https://jooble.org/api/about
JOOBLE_API_KEY=tu_key_de_jooble_aqui

# --- Producción ---
ENVIRONMENT=development
# Orígenes CORS permitidos (coma-separados). Vacío = mismo origen (por defecto,
# el dashboard lo sirve el propio FastAPI y no hace falta CORS).
CORS_ORIGINS=

# --- Logging ---
LOG_LEVEL=INFO
